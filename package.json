{
  "name": "shutafim-or-hatorah",
  "version": "0.1.0",
  "private": true,
  "description": "שותפים בהפצת אור התורה — אתר הקדשות ותרומות (גרסה ראשונה, ללא סליקה)",
  "type": "module",
  "scripts": {
    "build": "node --import tsx build.mjs",
    "dev": "node --import tsx build.mjs --watch --serve",
    "start": "node --import tsx build.mjs --serve-only",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "node tests/e2e.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.0",
    "playwright": "^1.50.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0 || ^6.0.0"
  }
}
